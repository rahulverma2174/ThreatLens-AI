# Local databases and database backups
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
backups/

# Environment files and local secrets (keep checked-in examples only)
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Frontend dependencies and generated output
**/node_modules/
frontend/dist/
dist/

# Python environments, caches and generated files
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
htmlcov/

# Logs and local runtime artifacts
*.log
logs/
*.pid
*.sock
.DS_Store
Thumbs.db

# All local Python virtual environments and uv cache
**/.venv*/
**/.uv/
