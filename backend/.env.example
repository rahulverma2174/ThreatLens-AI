## Local mode is the default. For hosted demo, follow README security prerequisites.
# THREATLENS_AUTH_MODE=demo
# THREATLENS_DEMO_USERNAME=replace-with-demo-user
# Generate the scrypt hash locally with: python -m scripts.hash_demo_password
# Never put a plaintext password or a real credential in this example file.
# THREATLENS_DEMO_PASSWORD_HASH=replace-with-generated-scrypt-hash
# Set this to the exact HTTPS origin serving the frontend.
# THREATLENS_CORS_ORIGINS=https://your-frontend.example.invalid
# Use a NEW empty PostgreSQL database for hosted demo; do not upload local SQLite.
# THREATLENS_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
# SameSite=None requires Secure cookies; demo mode enables Secure automatically.
# THREATLENS_COOKIE_SAMESITE=none

## Optional local Ollama wording assistance. Core deterministic features work without Ollama.
# THREATLENS_OLLAMA_URL=http://127.0.0.1:11434
# THREATLENS_OLLAMA_MODEL=qwen2.5:3b
# THREATLENS_OLLAMA_TIMEOUT_SECONDS=90

THREATLENS_SYSLOG_ENABLED=false
THREATLENS_SYSLOG_HOST=127.0.0.1
THREATLENS_SYSLOG_PORT=5514
THREATLENS_SYSLOG_ALLOWED_SOURCES=127.0.0.1/32,::1/128
THREATLENS_SYSLOG_MAX_MESSAGE_BYTES=8192
